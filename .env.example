# Copy this file to .env and fill in values as needed.
# If MONGO_URI is left blank, the app runs in JSON fallback (demo) mode —
# safe for hackathon demos without any DB setup.

PORT=4000
MONGO_URI=
# A secret used to sign JWT access tokens. Set this to enable signed tokens
# for RBAC. If unset, the app falls back to the legacy base64 token scheme
# with a console.warn (demo-compatibility). Replace with a secure random
# string in production.
JWT_SECRET=
